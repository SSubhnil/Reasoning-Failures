FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    HOME=/home/user \
    HF_HOME=/app/.hf \
    SST_MCP_CACHE_DIR=/tmp/sst_mcp

# Hugging Face Docker Spaces run as uid 1000.
RUN useradd -m -u 1000 user && mkdir -p /app && chown user:user /app
WORKDIR /app
USER user

COPY --chown=user requirements-mcp.txt ./
RUN pip install --no-cache-dir -r requirements-mcp.txt

COPY --chown=user pyproject.toml README.md LICENSE NOTICE ./
COPY --chown=user sst/__init__.py sst/__init__.py
COPY --chown=user sst/shared/ sst/shared/
COPY --chown=user sst_mcp/ sst_mcp/
RUN pip install --no-cache-dir --no-deps -e .

RUN python -c "import duckdb; duckdb.sql('INSTALL httpfs')"
RUN python -c "from tokenizers import Tokenizer; Tokenizer.from_pretrained('Qwen/Qwen3-4B')"

ENV PATH=/home/user/.local/bin:$PATH
EXPOSE 7860
CMD ["python", "-m", "sst_mcp", "--http", "--host", "0.0.0.0", "--port", "7860"]
